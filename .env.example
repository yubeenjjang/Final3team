# 로컬 .env에는 실제 값을 넣되, 이 예시 파일에는 비밀번호를 적지 않습니다.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER_USERNAME=noldaga_app
DB_USER_PASSWORD=
DB_SERVICE_USERNAME=noldaga_service
DB_SERVICE_PASSWORD=
# 스키마 적용 전용 관리자 접속 문자열(런타임 계정과 분리)
DB_MIGRATION_DSN=

# 서울시 문화행사 축제 보강 수집. 027_src2를 적용한 뒤 필요한 환경에서 켭니다.
SEOUL_CULTURE_ENABLED=false
SEOUL_OPEN_API_KEY=

# 자체 인증. db 모드에서 JWT_SECRET에 32바이트 이상의 임의 비밀값을 설정합니다.
AUTH_PROVIDER=mock
JWT_SECRET=
JWT_ISSUER=noldaga-api
ACCESS_JWT_TTL_MIN=30
REFRESH_TTL_DAYS=14
REFRESH_LOCK_TTL_S=5
AUTH_RATE_LIMIT_PER_MIN=10

# 선택한 귀가 경로의 서울 버스 차내 혼잡. real 모드는 공공데이터 서비스 키를 사용합니다.
BUS_CROWD_PROVIDER=mock
DATA_GO_KR_SERVICE_KEY=

# A06 DB 모드의 API·워커 설정. 토큰 키는 모든 API 인스턴스에 같은 32바이트 이상 비밀값을 사용합니다.
ASSISTANT_PROVIDER=mock
ASSISTANT_TOKEN_SECRET=
ASSISTANT_RATE_LIMIT_PER_MIN=10
# Festival Agent 구현을 병합한 뒤 필요하면 agents 패키지 안의 모듈:함수로 지정합니다.
# ASSISTANT_FESTIVAL_RUNNER=agents.festival_agent:run
