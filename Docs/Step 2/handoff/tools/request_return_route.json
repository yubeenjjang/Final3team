{
  "name": "request_return_route",
  "description": "축제장에서 목적지까지 귀가 경로를 요청한다. 축제와 목적지가 모두 정해졌을 때만 쓴다.",
  "parameters": {
    "type": "object",
    "properties": {
      "festival_id": {
        "type": "string",
        "description": "출발 축제 ID"
      },
      "destination": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lat": {
            "type": "number",
            "minimum": 33,
            "maximum": 39
          },
          "lng": {
            "type": "number",
            "minimum": 124,
            "maximum": 132
          }
        }
      },
      "travel_mode": {
        "type": "string",
        "enum": [
          "transit",
          "walk",
          "car",
          "taxi"
        ],
        "default": "transit"
      },
      "route_preference": {
        "type": "string",
        "enum": [
          "fastest",
          "less_crowded",
          "accessible",
          "min_walk",
          "fewest_transfers"
        ],
        "default": "fastest"
      },
      "user_constraints": {
        "type": "object",
        "properties": {
          "with_child": {
            "type": "boolean"
          },
          "wheelchair": {
            "type": "boolean"
          },
          "max_walk_m": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5000
          }
        }
      }
    },
    "required": [
      "festival_id",
      "destination"
    ]
  }
}